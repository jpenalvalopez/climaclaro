VITE_BASE44_APP_ID=698c54d09e4046a82210a18e
VITE_BASE44_APP_BASE_URL=https://base44.app
VITE_ENABLE_LOCAL_ADMIN_LOGIN=true
VITE_LOCAL_ADMIN_PASSWORD=change-me
# Solo para desarrollo con Vite si Express corre en otro puerto. En produccion, omitir para usar misma origin.
VITE_QUOTES_API_BASE_URL=http://127.0.0.1:8080
VITE_ADMIN_API_SECRET=dev-change-me

# Backend propio para presupuestos Quote. No usar prefijo VITE_ para no exponerlo al frontend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ADMIN_API_SECRET=dev-change-me
# Opcional: DATABASE_SSL=false solo para Postgres local sin SSL.
