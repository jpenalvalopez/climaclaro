{
  "name": "Review",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "author",
    "rating",
    "text"
  ]
}