{
  "name": "Service",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nombre del servicio"
    },
    "slug": {
      "type": "string",
      "description": "URL slug \u00fanico"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extras": {
      "type": "array",
      "description": "Extras contratables adicionales",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "description": "Unidad de medida: ud., m.l., m\u00b2, h., etc."
          },
          "min_qty": {
            "type": "number",
            "description": "Cantidad m\u00ednima",
            "default": 1
          },
          "max_qty": {
            "type": "number",
            "description": "Cantidad m\u00e1xima (0 = sin l\u00edmite)"
          }
        }
      }
    },
    "image_url": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "tipoServicioEnum": {
      "type": "string",
      "enum": [
        "Instalaci\u00f3n Split 1x1",
        "Instalaci\u00f3n Multisplit 2x1",
        "Instalaci\u00f3n Multisplit 3x1",
        "Instalaci\u00f3n Multisplit 4x1",
        "Instalaci\u00f3n Multisplit 5x1",
        "Mantenimiento/Limpieza",
        "Visita t\u00e9cnica"
      ]
    },
    "power_kw_min": {
      "type": "number",
      "description": "Potencia m\u00ednima en kW para la que aplica este servicio (inclusive)."
    },
    "power_kw_max": {
      "type": "number",
      "description": "Potencia m\u00e1xima en kW para la que aplica este servicio (inclusive)."
    }
  },
  "required": [
    "title",
    "slug",
    "tipoServicioEnum"
  ]
}