{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "description": "Numero profesional del presupuesto, formato PRES-YYYY-0001"
    },
    "public_token": {
      "type": "string",
      "unique": true,
      "description": "Token publico no adivinable para enlaces de cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected",
        "expired"
      ],
      "default": "draft"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_postal_code": {
      "type": "string"
    },
    "customer_city": {
      "type": "string"
    },
    "customer_province": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "manual",
        "lead",
        "lead_landing",
        "presupuesto"
      ],
      "default": "manual"
    },
    "source_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "product",
              "service",
              "extra",
              "custom"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "tax_rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "product_id": {
            "type": "string"
          },
          "service_id": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_rate": {
      "type": "number",
      "default": 21
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "quote_number",
    "customer_name",
    "customer_phone"
  ]
}
