{
  "name": "ModelPage",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "Nombre de la marca (ej: Mitsubishi)"
    },
    "model_code": {
      "type": "string",
      "description": "C\u00f3digo del modelo (ej: MSZ-AP). Debe coincidir con model_code de los productos."
    },
    "slug": {
      "type": "string",
      "description": "URL slug \u00fanico, ej: mitsubishi-msz-ap"
    },
    "hero_image_url": {
      "type": "string",
      "description": "URL imagen de fondo del hero"
    },
    "hero_title": {
      "type": "string",
      "description": "T\u00edtulo principal del hero"
    },
    "hero_subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo del hero"
    },
    "intro_title": {
      "type": "string",
      "description": "T\u00edtulo del bloque intro"
    },
    "intro_text": {
      "type": "string",
      "description": "Texto del bloque intro"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Caracter\u00edsticas destacadas del modelo"
    },
    "cta_title": {
      "type": "string",
      "description": "T\u00edtulo del CTA final"
    },
    "cta_text": {
      "type": "string",
      "description": "Texto del CTA final"
    },
    "seo_title": {
      "type": "string",
      "description": "T\u00edtulo SEO (meta title)"
    },
    "seo_description": {
      "type": "string",
      "description": "Meta descripci\u00f3n SEO"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "brand_name",
    "model_code",
    "slug"
  ]
}