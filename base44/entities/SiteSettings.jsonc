{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "site_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "description": "Texto bajo el logo en el footer"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "schedule": {
      "type": "string",
      "description": "Horario de atenci\u00f3n, ej: L-V 9:00\u201319:00 | S 10:00\u201314:00"
    },
    "service_area": {
      "type": "string",
      "description": "Texto corto zona (top bar)"
    },
    "service_areas_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de zonas de servicio para el footer"
    },
    "logo_url": {
      "type": "string"
    },
    "favicon_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "footer_text": {
      "type": "string"
    },
    "show_energy_calculator": {
      "type": "boolean",
      "default": true,
      "description": "Mostrar calculadora de ahorro energ\u00e9tico en la p\u00e1gina de productos"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "site_name"
  ]
}