{
  "name": "PromoSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo principal del slide"
    },
    "subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo o descripci\u00f3n breve"
    },
    "badge": {
      "type": "string",
      "description": "Etiqueta peque\u00f1a (ej: Oferta, Nuevo, M\u00e1s vendido)"
    },
    "cta_label": {
      "type": "string",
      "description": "Texto del bot\u00f3n de llamada a la acci\u00f3n"
    },
    "cta_url": {
      "type": "string",
      "description": "URL de destino del bot\u00f3n (ej: /Products?category=monosplit)"
    },
    "image_url": {
      "type": "string",
      "description": "URL de la imagen de fondo del slide"
    },
    "gradient_from": {
      "type": "string",
      "description": "Color inicial del gradiente (hex, ej: #003366)"
    },
    "gradient_to": {
      "type": "string",
      "description": "Color final del gradiente (hex, ej: #00509E)"
    },
    "show_in_products": {
      "type": "boolean",
      "default": true,
      "description": "Mostrar en la p\u00e1gina de Productos"
    },
    "show_in_home": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar en la p\u00e1gina de Inicio"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Slide activo"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Orden de aparici\u00f3n"
    }
  },
  "required": [
    "title"
  ]
}