{
  "name": "WebContent",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "enum": [
        "about",
        "legal",
        "install",
        "warranty",
        "returns"
      ]
    },
    "key": {
      "type": "string",
      "description": "Clave \u00fanica (ej: about.nosotros, install.condiciones)"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Contenido largo en Markdown o HTML"
    },
    "content_format": {
      "type": "string",
      "enum": [
        "markdown",
        "html"
      ],
      "default": "markdown"
    },
    "image_url": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "page"
  ]
}