{
  "name": "PageSection",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "enum": [
        "home",
        "about",
        "services",
        "products",
        "contact",
        "wizard"
      ]
    },
    "key": {
      "type": "string",
      "description": "Identificador \u00fanico (ej: home.hero)"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "page",
    "key",
    "title"
  ]
}